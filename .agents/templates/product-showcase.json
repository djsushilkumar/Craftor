{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "tpl_product_showcase",
  "name": "WooCommerce Featured Product Showcase",
  "category": "E-Commerce",
  "ast_template": {
    "elType": "container",
    "settings": { "flex_direction": "row" },
    "elements": [
      {
        "elType": "widget",
        "widgetType": "image",
        "settings": { "image": { "url": "placeholder" } }
      },
      {
        "elType": "container",
        "settings": { "flex_direction": "column" },
        "elements": [
          {
            "elType": "widget",
            "widgetType": "heading",
            "settings": { "title": "Premium Sneaker" }
          },
          { "elType": "widget", "widgetType": "button", "settings": { "text": "Add to Cart" } }
        ]
      }
    ]
  }
}
