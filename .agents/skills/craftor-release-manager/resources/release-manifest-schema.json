{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseManifestSchema",
  "type": "object",
  "required": ["version", "release_date", "channel", "packages", "rollout_percentage"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.]+)?$" },
    "release_date": { "type": "string", "format": "date" },
    "channel": { "type": "string", "enum": ["stable", "beta", "canary"] },
    "packages": { "type": "object" },
    "rollout_percentage": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
